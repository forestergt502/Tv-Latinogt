name: Actualizar TV Latino

"on":
  workflow_dispatch:
  schedule:
    - cron: "20 10 * * *"

permissions:
  contents: write

jobs:
  actualizar:
    runs-on: ubuntu-latest

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Generar TV Latino
        shell: python
        run: |
          import urllib.request
          import re

          PLAYLISTS = [
              "https://iptv-org.github.io/iptv/countries/ar.m3u",
              "https://iptv-org.github.io/iptv/countries/bo.m3u",
              "https://iptv-org.github.io/iptv/countries/cl.m3u",
              "https://iptv-org.github.io/iptv/countries/co.m3u",
              "https://iptv-org.github.io/iptv/countries/cr.m3u",
              "https://iptv-org.github.io/iptv/countries/do.m3u",
              "https://iptv-org.github.io/iptv/countries/ec.m3u",
              "https://iptv-org.github.io/iptv/countries/sv.m3u",
              "https://iptv-org.github.io/iptv/countries/gt.m3u",
              "https://iptv-org.github.io/iptv/countries/hn.m3u",
              "https://iptv-org.github.io/iptv/countries/mx.m3u",
              "https://iptv-org.github.io/iptv/countries/ni.m3u",
              "https://iptv-org.github.io/iptv/countries/pa.m3u",
              "https://iptv-org.github.io/iptv/countries/py.m3u",
              "https://iptv-org.github.io/iptv/countries/pe.m3u",
              "https://iptv-org.github.io/iptv/countries/pr.m3u",
              "https://iptv-org.github.io/iptv/countries/uy.m3u",
              "https://iptv-org.github.io/iptv/countries/ve.m3u",
          ]

          SPORTS = re.compile(
              r"sport|sports|deporte|deportes|futbol|fútbol|soccer|"
              r"tudn|tyc|goltv|gol tv|winsports|win sports|tigo sports|"
              r"teleangol|telesur deporte|canal del futbol|cdf|"
              r"futv|td mas|tdmás|directv sports",
              re.I
          )

          MOVIES = re.compile(
              r"movie|movies|cine|cinema|pelicula|película|peliculas|"
              r"películas|film|films|cinecanal|cinelatino|cinelatino|"
              r"accion|acción|terror|western|classic movies",
              re.I
          )

          SERIES = re.compile(
              r"series|serie|novela|novelas|telenovela|telenovelas|"
              r"drama|series tv|retro series",
              re.I
          )

          ANIME = re.compile(
              r"anime|animax|otaku|manga|anime station|animestation|"
              r"anime tv|anime latino",
              re.I
          )

          MUSIC = re.compile(
              r"music|musica|música|musical|mtv|radio tv|"
              r"telehit|ritmos|videos musicales|video music|"
              r"rock|pop music|latin music",
              re.I
          )

          def descargar(url):
              req = urllib.request.Request(
                  url,
                  headers={
                      "User-Agent": "Mozilla/5.0 TV-Latino/2.0"
                  }
              )

              with urllib.request.urlopen(
                  req,
                  timeout=60
              ) as response:

                  return response.read().decode(
                      "utf-8",
                      errors="ignore"
                  )

          grupos = {
              "⚽ Deportes": [],
              "🎬 Películas": [],
              "📺 Series": [],
              "🐉 Anime": [],
              "🎵 Música": [],
          }

          encontrados = set()

          for playlist in PLAYLISTS:

              try:

                  print("Descargando:", playlist)

                  contenido = descargar(playlist)

              except Exception as e:

                  print(
                      "No se pudo descargar",
                      playlist,
                      e
                  )

                  continue

              lineas = contenido.splitlines()

              i = 0

              while i < len(lineas):

                  linea = lineas[i].strip()

                  if not linea.startswith("#EXTINF"):
                      i += 1
                      continue

                  if i + 1 >= len(lineas):
                      break

                  url = lineas[i + 1].strip()

                  if not url.startswith(
                      ("http://", "https://")
                  ):
                      i += 2
                      continue

                  try:

                      nombre = linea.split(
                          ",",
                          1
                      )[1].strip()

                  except:

                      nombre = "Canal"

                  texto = (
                      nombre + " " + linea
                  ).lower()

                  grupo = None

                  # Anime primero para evitar que
                  # canales de anime caigan en Series.
                  if ANIME.search(texto):

                      grupo = "🐉 Anime"

                  elif SPORTS.search(texto):

                      grupo = "⚽ Deportes"

                  elif MOVIES.search(texto):

                      grupo = "🎬 Películas"

                  elif SERIES.search(texto):

                      grupo = "📺 Series"

                  elif MUSIC.search(texto):

                      grupo = "🎵 Música"

                  if grupo is None:

                      i += 2
                      continue

                  if url in encontrados:

                      i += 2
                      continue

                  encontrados.add(url)

                  # Reemplazar categoría existente
                  if 'group-title="' in linea:

                      linea = re.sub(
                          r'group-title="[^"]*"',
                          f'group-title="{grupo}"',
                          linea
                      )

                  else:

                      linea = linea.replace(
                          "#EXTINF:-1",
                          '#EXTINF:-1 '
                          f'group-title="{grupo}"'
                      )

                  grupos[grupo].append(
                      (
                          nombre.lower(),
                          linea,
                          url
                      )
                  )

                  i += 2

          orden = [
              "⚽ Deportes",
              "🎬 Películas",
              "📺 Series",
              "🐉 Anime",
              "🎵 Música",
          ]

          salida = ["#EXTM3U"]

          total = 0

          for grupo in orden:

              canales = sorted(
                  grupos[grupo],
                  key=lambda x: x[0]
              )

              print(
                  grupo,
                  "=",
                  len(canales),
                  "canales"
              )

              for _, info, url in canales:

                  salida.append(info)
                  salida.append(url)

                  total += 1

          with open(
              "TV_Latino.m3u",
              "w",
              encoding="utf-8",
              newline="\n"
          ) as archivo:

              archivo.write(
                  "\n".join(salida) + "\n"
              )

          print(
              "TOTAL:",
              total,
              "canales"
          )

          if total == 0:

              raise RuntimeError(
                  "No se encontraron canales. "
                  "La lista anterior se conservará."
              )

      - name: Guardar cambios
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add TV_Latino.m3u

          if git diff --cached --quiet; then
            echo "No hay cambios."
            exit 0
          fi

          git commit -m "Actualizar deportes peliculas series anime musica"
          git push
